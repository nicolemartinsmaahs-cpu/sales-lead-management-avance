<aura:component
    implements="lightning:actionOverride"
    access="global">

    <aura:attribute
        name="showSuccess"
        type="Boolean"
        default="false"/>

    <aura:handler
        name="init"
        value="{!this}"
        action="{!c.doInit}"/>

    <section
        role="dialog"
        tabindex="-1"
        aria-modal="true"
        class="slds-modal slds-fade-in-open">

        <div class="slds-modal__container">

            <header class="slds-modal__header">

                <button
                    class="slds-button slds-button_icon slds-modal__close slds-button_icon-inverse"
                    title="Fechar"
                    onclick="{!c.handleClose}">

                    <lightning:icon
                        iconName="utility:close"
                        alternativeText="Fechar"
                        variant="inverse"
                        size="small"/>

                    <span class="slds-assistive-text">
                        Fechar
                    </span>

                </button>

                <h2 class="slds-text-heading_medium">
                    Cadastro Inteligente de Lead
                </h2>

            </header>

            <div class="slds-modal__content slds-p-around_medium">

                <aura:if isTrue="{!v.showSuccess}">

                    <div class="slds-align_absolute-center slds-p-around_large">

                        <div class="slds-text-align_center">

                            <lightning:icon
                                iconName="utility:success"
                                alternativeText="Sucesso"
                                size="large"
                                variant="success"/>

                            <h2 class="slds-text-heading_medium slds-m-top_medium">
                                Lead criado com sucesso!
                            </h2>

                            <p class="slds-m-top_small">
                                O novo Lead foi cadastrado.
                            </p>

                        </div>

                    </div>

                    <aura:set attribute="else">

                        <lightning:flow
                            aura:id="leadFlow"
                            onstatuschange="{!c.handleStatusChange}"/>

                    </aura:set>

                </aura:if>

            </div>

        </div>

    </section>

    <div class="slds-backdrop slds-backdrop_open"></div>

</aura:component>